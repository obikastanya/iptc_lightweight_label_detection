# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Virtual environment (install ulang dari requirements, jangan di-push)
/env/
venv/
.venv/

# ---------------------------------------------------------------
# Data (±4 GB, bisa di-generate ulang lewat code/data/*)
# ---------------------------------------------------------------
# Pakai "/" di depan supaya package code/data/ TIDAK ikut ter-ignore
/data/

# ---------------------------------------------------------------
# Model & cache HuggingFace (ratusan MB – GB per file)
# Metadata kecil (meta.json, train_meta.json, config.json) tetap di-push
# ---------------------------------------------------------------
models/hf_cache/
models/**/*.bin
models/**/*.ftz
models/**/*.npz
models/**/*.onnx
models/**/*.safetensors
models/**/tokenizer.json

# ---------------------------------------------------------------
# Folder kerja agent / file uji sementara
# ---------------------------------------------------------------
/scratch/
.claude/*
!.claude/skills/
test.py
test_ori.py
test_compare.py
*.log

# Bundle zip untuk Colab (hasil build, bisa dibuat ulang)
*.zip

# Paket zip file besar untuk diunggah ke Google Drive
/_archive/gdrive_upload_v1/

# ---------------------------------------------------------------
# Jurnal LaTeX: file hasil kompilasi & salinan template IEEE
# (IEEEtran.cls/.bst yang dibutuhkan sudah ada di _archive/jurnal_latex_v1/)
# ---------------------------------------------------------------
_archive/jurnal_latex_v1/*.aux
_archive/jurnal_latex_v1/*.bbl
_archive/jurnal_latex_v1/*.blg
_archive/jurnal_latex_v1/*.out
_archive/jurnal_latex_v1/*.toc
_archive/jurnal_latex_v1/*.fls
_archive/jurnal_latex_v1/*.fdb_latexmk
_archive/jurnal_latex_v1/*.synctex.gz
_archive/jurnal_latex_v1/template_ieee/

# ---------------------------------------------------------------
# Dokumen pihak lain (paper referensi berhak cipta & contoh tugas teman)
# ---------------------------------------------------------------
/reference/
/sample/

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
~$*
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# final study: stored predictions (136 MB) go to Google Drive with models/
results/final/predictions/
models/**/*.joblib
models/**/*.onnx_data
models/**/sentencepiece.bpe.model
# release folders are build output (scripts/build_dist.py); pushed/uploaded separately
dist/

# Final paper (paper_final/): LaTeX build artifacts; main.pdf is kept like _archive/jurnal_latex_v1/
paper_final/*.aux
paper_final/*.bbl
paper_final/*.blg
paper_final/*.out
paper_final/*.synctex.gz
# IEEE Access template (contains licensed fonts; download again from ieeeaccess.ieee.org)
paper_writing/template_ieeeaccess/

# Video presentasi (besar, disimpan lokal / Drive)
/presentation/*.mp4
