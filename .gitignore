# ---------------------------------------------------------------
/scratch/
.claude/
test.py
test_ori.py
test_compare.py
*.log

# Bundle zip untuk Colab (hasil build, bisa dibuat ulang)
*.zip

# Paket zip file besar untuk diunggah ke Google Drive
/gdrive_upload/

# ---------------------------------------------------------------
# Jurnal LaTeX: file hasil kompilasi & salinan template IEEE
# (IEEEtran.cls/.bst yang dibutuhkan sudah ada di jurnal_latex/)
# ---------------------------------------------------------------
jurnal_latex/*.aux
jurnal_latex/*.bbl
jurnal_latex/*.blg
jurnal_latex/*.out
jurnal_latex/*.toc
jurnal_latex/*.fls
jurnal_latex/*.fdb_latexmk
jurnal_latex/*.synctex.gz
jurnal_latex/template_ieee/

# ---------------------------------------------------------------
# Dokumen pihak lain (paper referensi berhak cipta & contoh tugas teman)
# ---------------------------------------------------------------
/reference/
/sample/

